xargs sh -c '[ "$0" = "--" ] || set -- "$0" "$@"; lit=$(printf "\044VM_BAKE_CONTEXT_SCRIPT"); n=$#; while [ $n -gt 0 ]; do a=$1; shift; [ "$a" = "$lit" ] && a=$VM_BAKE_CONTEXT_SCRIPT; set -- "$@" "$a"; n=$((n-1)); done; exec "$@"' --
# Interpreter for 'bootstrap init' -- the line starts with env (VM_BAKE_BASE bound
# to the new database), so the combinator default (expand $1) cannot serve it: the
# words are exec'd as xargs split them, and only the one word that is the literal
# $VM_BAKE_CONTEXT_SCRIPT (printf \044 spells the dollar sign) is mapped to the
# script path. Set to cat for a dry-run.
# @see VM_BAKE_INTERPRETER_restore_replay
