sh -c 'tmp=$(mktemp "$VM_BAKE_BASE/.tmp/batch.XXXXXX"); chmod 0600 "$tmp"; cat > "$tmp"; exec "$VM_BAKE_CONTEXT_SCRIPT" batch "$tmp" true'
# Default interpreter for batch-combinator functions (triple underscore: ___).
#
# Batch-combinators emit SEVERAL re-invocation lines. This interpreter captures
# them into a secure temp file under $VM_BAKE_BASE/.tmp/ and hands the file to
# 'batch <tmp> true' (true = remove temp file after processing).
#
# For dry-run/inspection, override with 'cat'.
